# Скопировать в .env: cp .env.example .env. Для демо менять ничего не нужно.

# --- LLM (локальная, открытые веса) ---
# Пусто (OLLAMA_URL=) — LLM выключена, всё на правилах и шаблонах.
# На Mac быстрее нативная Ollama: OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://llm:11434
OLLAMA_MODEL=qwen3:4b
# Эмбеддинги для поиска, например bge-m3. Пусто — только лексический поиск (BM25).
EMBED_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- База ---
POSTGRES_DB=naparnik
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Backend ---
# Заменить уникальным секретом (32+ символа) перед развертыванием вне демо
SECRET_KEY=change-me-before-deployment-naparnik-demo-key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TIMEZONE=Europe/Moscow

# --- Интеграции (пусто — демо-режим, наружу ничего не уходит) ---
# Slack-бот: scopes chat:write, im:write, users:read
SLACK_BOT_TOKEN=
SLACK_DEMO_CHANNEL=
# NOTION_TOKEN=          # импорт страниц в базу знаний (план)
# CALENDAR_ICS_URL=      # календарь из ICS (план)
