# Скопировать в .env: cp .env.example .env
# Чтобы включить Claude, достаточно вписать ключ в LLM_API_KEY. Без ключа работает заглушка модели.

# --- Модель (переменные как в docs/04-mock-data/llm-stub.json) ---
# Ключ Claude (Anthropic). Только здесь: .env в .gitignore, в репозиторий не попадает.
LLM_API_KEY=
# Для DeepSeek вместо Claude: впишите ключ сюда, а LLM_API_KEY оставьте пустым
DEEPSEEK_API_KEY=
# anthropic | deepseek | stub. Пусто — выбирается по ключу.
LLM_PROVIDER=
# Пусто — claude-opus-5-5 / deepseek-chat. Дешевле: claude-sonnet-5-5
LLM_MODEL=
# Пусто — настоящая модель, если есть ключ. Для проверки сбоев: stub_ok | stub_slow | stub_timeout | stub_error
LLM_MODE=
LLM_TIMEOUT_SEC=30
# Глубина размышлений Claude: low | medium | high
LLM_EFFORT=medium
# Для OpenAI-совместимых API (по умолчанию для deepseek — https://api.deepseek.com)
LLM_BASE_URL=

# --- Демо ---
# «Сегодня» для демо; пусто — из мок-данных (2026-11-11)
DEMO_TODAY=
# Имитация сбоя сервисов: absence, access (через запятую)
MOCK_FAIL=
PORT=8080

# PostgreSQL для запуска через go run. Пусто — временное состояние в памяти.
# В Docker Compose адрес БД задаётся автоматически; данные лежат в томе pgdata.
DATABASE_URL=

# Redis для запуска через go run (кэш, коды Telegram, лимит запросов). Пусто — память процесса.
# В Docker Compose задаётся автоматически.
REDIS_URL=
# Сколько сообщений Напарнику в минуту на пользователя (защита от расхода токенов). 0 — без лимита
LLM_RATE_PER_MIN=20

# --- Уведомления в Telegram (SC-24, BR-50…53) ---
# Токен бота от @BotFather. НЕ коммитить. Пусто — режим log: уведомления пишутся в журнал сервера
TG_BOT_TOKEN=
# live | log; пусто — live, если токен задан
TG_MODE=
# Куда ведёт «Открыть →» в сообщениях бота
WEB_URL=http://localhost:3000
# Демо: присылать сразу, не дожидаясь рабочих часов и сводок 11:00/16:00
NOTIFY_IGNORE_HOURS=false
