# Скопировать в .env: cp .env.example .env. Для демо менять ничего не нужно.

# --- LLM (внешний API) ---
# Провайдер: claude | deepseek | mock. mock работает без ключа и без интернета (тесты, проверка экспертами).
LLM_PROVIDER=mock
# Модель. Пусто — по умолчанию для провайдера: claude-opus-5-5 / deepseek-chat. Дешевле: claude-sonnet-5-5
LLM_MODEL=
# Ключи — только здесь, в .env (он в .gitignore). В репозиторий не коммитить.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Глубина размышлений Claude: low | medium | high
LLM_EFFORT=medium
# Серверный fallback Claude при отказе модели: 1 — включён, 0 — выключен
LLM_FALLBACKS=1
LLM_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_ROUNDS=5

# --- База ---
POSTGRES_DB=naparnik
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Backend ---
# Заменить уникальным секретом (32+ символа) перед развертыванием вне демо
SECRET_KEY=change-me-before-deployment-naparnik-demo-key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TIMEZONE=Europe/Moscow

# --- Интеграции (пусто — демо-режим, наружу ничего не уходит) ---
# Slack-бот: scopes chat:write, im:write, users:read
SLACK_BOT_TOKEN=
SLACK_DEMO_CHANNEL=
# NOTION_TOKEN=          # импорт страниц в базу знаний (план)
# CALENDAR_ICS_URL=      # календарь из ICS (план)
